# ──────────────────────────────────────────────────────────────────────────────
# Graph of Skills -- Environment Configuration
# Copy this file to .env and fill in your API keys.
# ──────────────────────────────────────────────────────────────────────────────

# ── GoS core settings ────────────────────────────────────────────────────────
GOS_WORKING_DIR=./gos_workspace
GOS_PREBUILT_WORKING_DIR=
GOS_LLM_MODEL=gemini/gemini-3.1-flash-lite-preview

# ── Embedding provider (pick ONE section below) ─────────────────────────────
# The embedding model and dimension must match between indexing and retrieval.
# Code defaults: GOS_EMBEDDING_MODEL=openai/text-embedding-3-large, GOS_EMBEDDING_DIM=3072

# Option A: OpenAI API (matches code defaults; set OPENAI_API_KEY; leave OPENAI_BASE_URL unset)
# OPENAI_API_KEY=your-openai-api-key
# GOS_EMBEDDING_MODEL=openai/text-embedding-3-large
# GOS_EMBEDDING_DIM=3072

# Option B: Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GOS_EMBEDDING_MODEL=gemini/gemini-embedding-001
GOS_EMBEDDING_DIM=3072

# Option C: OpenRouter (explicit ``openrouter/...`` prefix routes via OpenRouter API)
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENAI_API_KEY=optional-fallback-same-as-openrouter-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# GOS_EMBEDDING_MODEL=openrouter/openai/text-embedding-3-large
# GOS_EMBEDDING_DIM=3072

# Option D: Azure AI / any OpenAI-compatible URL (no OpenRouter prefix)
# OPENAI_API_KEY=your-azure-api-key
# OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
# Use the deployment name your resource exposes (often not ``text-embedding-3-large``).
# GOS_EMBEDDING_MODEL=openai/embed-v-4-0
# GOS_EMBEDDING_DIM=1536
# (OPENROUTER_API_KEY in the environment is ignored for non-openrouter.ai bases.)

# ── Additional API keys (for evaluation tracks) ─────────────────────────────
# OPENROUTER_API_KEY=your-openrouter-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Graph construction / retrieval tuning ───────────────────────────────────
# Candidate pairs per focus skill; bounds submitted pairs at O(N * LINK_TOP_K).
GOS_LINK_TOP_K=8
# Minimum confidence for an LLM-proposed typed relation to be accepted.
GOS_RELATION_MIN_CONFIDENCE=0.75
# I/O overlap threshold for a deterministic dependency edge (paper: zeta).
# Lower = denser dependency edges. Swept 0.4-0.8 in the paper; 0.6 is the
# reported setting.
GOS_DEPENDENCY_MATCH_THRESHOLD=0.6
GOS_OPENROUTER_RESPONSE_CACHE=true
GOS_CONSTRUCTION_REPORT=true
GOS_RELINK_CONCURRENCY=8
GOS_RELINK_CHECKPOINT_EVERY=10

# ── Graph construction ──────────────────────────────────────────────────────
# Sparse LLM validation of workflow/semantic/alternative relations.
GOS_ENABLE_SEMANTIC_LINKING=true
# Domain hint given to the extraction prompts.
GOS_DOMAIN=Agent Skills and Tool Dependencies
# Index the full SKILL.md body rather than frontmatter only.
GOS_USE_FULL_MARKDOWN=true
GOS_EXTRACTION_CONCURRENCY=6
GOS_EMBEDDING_CONCURRENCY=4

# ── Reverse-aware PPR / seeding ─────────────────────────────────────────────
GOS_PPR_DAMPING=0.2
GOS_PPR_MAX_ITER=50
GOS_PPR_TOLERANCE=1e-6
# Candidate pool sizes per seeding channel before merge and rerank.
GOS_SEED_CANDIDATE_TOP_K_SEMANTIC=20
GOS_SEED_CANDIDATE_TOP_K_LEXICAL=20
GOS_RERANK_CANDIDATE_MULTIPLIER=4
# Optional query rewrite; disabled for all reported experiments.
GOS_ENABLE_QUERY_REWRITE=false
# Per-skill execution-note snippet length in the hydrated bundle.
GOS_SNIPPET_CHARS=900

# ── Skill discovery / container layout ──────────────────────────────────────
GOS_SKILL_FILENAME=SKILL.md
GOS_ALLOW_FRONTMATTER_DOCS=true
# Container-side skill root, used to rewrite `Source:` paths. Empty = off.
GOS_SKILLS_DIR=
GOS_SEED_TOP_K=5
GOS_RETRIEVAL_TOP_N=8
GOS_MAX_SKILL_CHARS=2400
GOS_MAX_CONTEXT_CHARS=12000
